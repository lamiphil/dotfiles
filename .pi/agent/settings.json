{
  "lastChangelogVersion": "1.5.0",
  "defaultProvider": "openai-codex",
  "theme": "onedark-pro",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "high",
  "packages": [
    "npm:pi-powerline-footer",
    "npm:pi-custom-compaction",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-lsp-extension",
    "npm:pi-web-access",
    "npm:vim-motions-pi",
    "npm:pi-observational-memory",
    "git:github.com/elpapi42/pi-fork",
    "npm:pi-event-monitor",
    "npm:@mobrienv/pi-tidy-tools",
    "npm:@mobrienv/pi-tidy-subagents",
    {
      "source": "git:github.com/paoloanzn/pi-black@v0.84.1-cc2.1.280.1",
      "extensions": []
    },
    "git:github.com/DietrichGebert/ponytail",
    "https://github.com/earendil-works/pi-claude-code",
    "npm:pi-artifacts"
  ],
  "compaction": {
    "enabled": true
  },
  "workingVibe": "adeptus mechanicus",
  "workingVibeMode": "file",
  "workingVibeFallback": "Praising the Omnissiah",
  "showLastPrompt": false,
  "powerline": {
    "preset": "default",
    "workingIndicatorPlacement": "above-powerline",
    "fixedEditor": true,
    "mouseScroll": true,
    "layout": {
      "left": [
        "path",
        "custom:agent-mode",
        "session"
      ]
    },
    "customItems": [
      {
        "id": "agent-mode",
        "statusKey": "agent-mode",
        "position": "left",
        "hideWhenMissing": false,
        "excludeFromExtensionStatuses": true
      },
      {
        "id": "kube",
        "statusKey": "kube",
        "position": "secondary",
        "hideWhenMissing": true,
        "excludeFromExtensionStatuses": true
      },
      {
        "id": "cloud",
        "statusKey": "cloud",
        "position": "secondary",
        "hideWhenMissing": true,
        "excludeFromExtensionStatuses": true
      },
      {
        "id": "vim-mode",
        "statusKey": "vim-mode",
        "position": "secondary-right",
        "hideWhenMissing": false,
        "excludeFromExtensionStatuses": true
      },
      {
        "id": "note-vault",
        "statusKey": "note-vault",
        "position": "secondary",
        "color": "accent",
        "hideWhenMissing": true,
        "excludeFromExtensionStatuses": true
      }
    ]
  },
  "powerlineShortcuts": {
    "stashHistory": "ctrl+alt+h",
    "copyEditor": "ctrl+alt+c",
    "cutEditor": "ctrl+alt+x"
  },
  "editorPaddingX": 0,
  "tuiMode": "fullscreen",
  "shellCommandPrefix": "shopt -s expand_aliases\nsource ~/.bash_aliases 2>/dev/null",
  "steeringMode": "one-at-a-time",
  "doubleEscapeAction": "tree",
  "quietStartup": true,
  "treeFilterMode": "default",
  "warnings": {
    "anthropicExtraUsage": false
  },
  "hideThinkingBlock": true,
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-powerline-footer\",\"scope\":\"user\"}": "0.22.0",
    "{\"source\":\"npm:pi-custom-compaction\",\"scope\":\"user\"}": "0.2.5",
    "{\"source\":\"npm:pi-lsp-extension\",\"scope\":\"user\"}": "1.4.0",
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.46.0",
    "{\"source\":\"npm:pi-event-monitor\",\"scope\":\"user\"}": "0.1.0",
    "{\"source\":\"npm:@mobrienv/pi-tidy-subagents\",\"scope\":\"user\"}": "0.3.1"
  }
}